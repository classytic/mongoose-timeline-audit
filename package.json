{
  "name": "mongoose-timeline-audit",
  "version": "2.0.0",
  "description": "Mongoose plugin for comprehensive timeline and audit trail tracking with actor resolution and auto-trimming",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./event-types": {
      "types": "./dist/event-types.d.ts",
      "import": "./dist/event-types.js"
    },
    "./context-helpers": {
      "types": "./dist/context-helpers.d.ts",
      "import": "./dist/context-helpers.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mongoose",
    "plugin",
    "timeline",
    "audit",
    "audit-trail",
    "audit-log",
    "actor-tracking",
    "mongodb",
    "history",
    "event-tracking",
    "activity-log",
    "event-sourcing",
    "multi-tenant",
    "compliance",
    "typescript",
    "nodejs"
  ],
  "author": "Sadman Chowdhury (https://github.com/siam923)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siam923/mongoose-timeline-audit.git"
  },
  "bugs": {
    "url": "https://github.com/siam923/mongoose-timeline-audit/issues"
  },
  "homepage": "https://github.com/siam923/mongoose-timeline-audit#readme",
  "peerDependencies": {
    "mongoose": "^8.0.0 || ^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "mongodb-memory-server": "^10.2.3",
    "mongoose": "^9.1.3",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run typecheck",
    "release:patch": "npm version patch && npm run build && npm publish --access public",
    "release:minor": "npm version minor && npm run build && npm publish --access public",
    "release:major": "npm version major && npm run build && npm publish --access public"
  }
}
